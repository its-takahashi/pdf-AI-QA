<?xml version="1.0" encoding="utf-8"?>
<configuration>

	<!--
    ※ 暗号化はまだ実行しません（先生の指示待ち）。
       ここでは平文で設定を置きます。必要になったら後で ProtectAppSettings を案内します。
  -->

	<appSettings>
		<!-- 使用するモデル名（Form1.csの既定値は gemini-2.5-flash-latest） -->
		<add key="GeminiModel" value="gemini-3.5-flash-lite" />

		<!-- 1日の上限の既定値（簡易カウンタ用。モデルごとの上限は「モデル設定」で変更できます） -->
		<add key="DailyRequestQuota" value="20" />

		<!-- 429/5xx での自動リトライ設定（指数バックオフ＋Retry-After優先） -->
		<add key="RetryMaxAttempts" value="3" />
		<add key="RetryBaseDelayMs" value="1000" />
		<add key="RetryBackoffFactor" value="2.0" />
	</appSettings>

	<!-- （任意）.NET Framework向けのスタートアップセクション。既存プロジェクトに合わせて調整/省略可。 -->
	<!--
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  -->

	<!-- （任意）暗号化プロバイダの宣言。暗号化は「次のステップ」指示まで実行しません。 -->
	<!--
  <configProtectedData>
    <providers>
      <add name="DataProtectionConfigurationProvider"
           type="System.Configuration.DpapiProtectedConfigurationProvider, System.Configuration"
           description="Protect configuration sections using DPAPI" />
      <add name="RsaProtectedConfigurationProvider"
           type="System.Configuration.RsaProtectedConfigurationProvider, System.Configuration"
           description="Protect configuration sections using RSA" />
    </providers>
  </configProtectedData>
  -->

	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">

			<!-- 依存関係の“実在する”アセンブリ版に合わせて統一 -->
			<dependentAssembly>
				<assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<!-- packages: System.Buffers 4.5.1 のアセンブリ版は 4.0.3.0 -->
				<bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.3.0" />
				<!-- ※ 将来 System.Buffers を 4.6.0 以降に上げたら newVersion を 4.0.5.0 に変更 -->
			</dependentAssembly>

			<dependentAssembly>
				<assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<!-- packages: System.Memory 4.5.5 のアセンブリ版は 4.0.1.2 -->
				<bindingRedirect oldVersion="0.0.0.0-4.0.1.2" newVersion="4.0.1.2" />
			</dependentAssembly>

			<dependentAssembly>
				<assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
				<!-- packages: 6.0.0 のアセンブリ版は 6.0.0.0 -->
				<bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
			</dependentAssembly>

			<dependentAssembly>
				<assemblyIdentity name="System.Numerics.Vectors" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
				<!-- packages: 4.5.0 のアセンブリ版は 4.1.4.0 -->
				<bindingRedirect oldVersion="0.0.0.0-4.1.4.0" newVersion="4.1.4.0" />
			</dependentAssembly>

			<dependentAssembly>
				<assemblyIdentity name="System.Threading.Tasks.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<!-- packages: 4.5.4 のアセンブリ版は 4.2.0.1 -->
				<bindingRedirect oldVersion="0.0.0.0-4.2.0.1" newVersion="4.2.0.1" />
			</dependentAssembly>

			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Bcl.AsyncInterfaces" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<!-- packages: 9.0.9 のアセンブリ版は 9.0.0.9 -->
				<bindingRedirect oldVersion="0.0.0.0-9.0.0.9" newVersion="9.0.0.9" />
			</dependentAssembly>

			<!-- ▼ 以下は “現在の packages.config にない”ため削除
           System.Text.Json / Google.Protobuf / Microsoft.Bcl.Memory / System.IO.Pipelines など
          （存在しない版にリダイレクトすると逆に解決不能になります） -->

		</assemblyBinding>
	</runtime>
</configuration>
